# Server Environment Variables
# Copy this file to .env and fill in your values

# ─── Server ───────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
DB_NAME=college-coding-platform

# ─── JWT ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ─── Email (SMTP) ──────────────────────────────────────────────────────────
# For development, use Mailtrap: https://mailtrap.io
# For production, use Gmail App Password or SendGrid
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
EMAIL_FROM="College Platform <noreply@college.edu>"

# ─── Judge0 ───────────────────────────────────────────────────────────────
# Self-hosted: http://localhost:2358
# RapidAPI (dev): https://judge0-ce.p.rapidapi.com
JUDGE0_API_URL=http://localhost:2358
JUDGE0_API_KEY=

# ─── Client ───────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Admin Seed ───────────────────────────────────────────────────────────
# Used only by the seed-admin.js script — run once during initial setup
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=ChangeMe@123
ADMIN_NAME=Platform Admin
